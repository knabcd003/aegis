# Aegis AI v7 — Environment Variables
# Copy this file to .env and fill in your actual keys

# Market Data Keys
FINNHUB_API_KEY=your_finnhub_key_here
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets/v2
FRED_API_KEY=your_fred_key_here
SEC_EDGAR_EMAIL=your_email@domain.com

# LLM Provider API Keys
GROQ_API_KEY=your_groq_key_here
GEMINI_API_KEY=your_gemini_key_here
OPENROUTER_API_KEY=your_openrouter_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
CEREBRAS_API_KEY=your_cerebras_key_here

# Database Settings
CHROMA_DB_DIR=./memory/vector_store
SQLITE_DB_PATH=./memory/trade_history.db

# Aegis v7 Security
AEGIS_SECRET_KEY=generate_a_fernet_key_here
OPENCLAW_API_SECRET=change_in_production
DEBUG=true
