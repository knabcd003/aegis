            "enabled": true,
            "cluster_window_days": 45
        }
    },
    "position_sizing": {
        "capital": 100000,
        "max_position_pct": 0.15,
        "method": "equal_weight"
    },
    "sandbox": {
        "slippage_bps": 15,
        "min_hold_days": 5,
        "promotion_criteria": {
            "held_out_sharpe_min": 0.85,
            "held_out_degradation_max": 0.35
        }
    },
    "routing": {
        "mode": "build",
        "logging": {
            "depth": "production"
        }
    }
}