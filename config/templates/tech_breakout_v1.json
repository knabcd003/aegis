{
    "config_id": "tech_breakout_v1",
    "version": "1.0.0",
    "asset_universe": {
        "tickers": [
            "AAPL",
            "MSFT",
            "NVDA",
            "GOOGL",
            "META",
            "TSLA",
            "AMZN"
        ],
        "benchmark": "SPY"
    },
    "signal_gate": {
        "finbert_above": 0.5,
        "earnings_revision_direction": "up"
    },
